# Use the same pooled Neon URL as the backend.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require
# Production: use the public HTTPS origin (https://finverseaii.netlify.app).
# Register <BETTER_AUTH_URL>/api/auth/callback/google in the matching Google
# OAuth client's Authorized redirect URIs; keep localhost for local development.
BETTER_AUTH_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
