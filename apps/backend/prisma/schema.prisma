generator client {
  provider = "prisma-client-js"
}

// B46 — DATABASE INVARIANT: Prisma cannot express CHECK constraints,
// so the following live ONLY in migration SQL and are NOT visible in
// this file. They are part of the schema contract; any change to them
// needs a new migration, and apps/backend/src/activity/schema-invariants.spec.ts
// asserts they still exist:
//   profile_budget_check (20261112000000): fixed + variable expenses +
//     savings target <= monthly income + other income
//   profile_investments_check (20261112000000): invested_amount is 0
//     unless already_investing
//   user_financial_profile_payday_check (20261113000000): payday 1–28
//   user_bills_positive_amount (20261113120000): bill amount > 0
//   user_transactions_nonzero_amount (20261113120000): amount <> 0
//   user_bill_payments_positive_amount (20261117130000): amount > 0
//   user_goal_contributions_positive_amount (20261117131000): amount > 0
//   user_bills_recurrence_check (20261123193600): recurrence IS NULL
//     OR 'monthly'
//   watchlist_alert_pair (20261123120000): alert_direction and
//     alert_price are set together or not at all
// The ivfflat vector index (20261119130000) likewise lives only in SQL;
// `prisma migrate` will report it as drift, which is expected.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  password      String?
  emailVerified Boolean @default(false)

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  image            String?
  sessions         Session[]
  accounts         Account[]
  financialProfile UserFinancialProfile?
  goals            UserGoal[]
  goalContributions UserGoalContribution[]
  bills            UserBill[]
  billPayments     UserBillPayment[]
  transactions     UserTransaction[]
  holdings         UserHolding[]
  watchlist        WatchlistItem[]
  ragDocuments     RagDocument[]
  guardrailChecks  GuardrailCheck[]
  idempotencyKeys  IdempotencyKey[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum EmploymentType {
  salaried
  self_employed @map("self-employed")
  student
  other
}

enum InvestmentExperience {
  none
  beginner
  intermediate
  advanced
}

enum RiskTolerance {
  low
  medium
  high
}

enum GoalPriority {
  low
  medium
  high
}

enum EmergencyFundMonths {
  zero         @map("0")
  one_to_three @map("1-3")
  three_to_six @map("3-6")
  six_plus     @map("6+")
}

model UserFinancialProfile {
  user_id                String               @id
  user                   User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // B47: NULL means "unknown / not asked" — these questions are not
  // always put to the user, so a missing answer must not be stored as
  // a false salaried/low-risk/zero-savings value. Downstream readers
  // must treat NULL as unknown, never as a default.
  employment_type        EmploymentType?
  monthly_income         Decimal              @db.Decimal(12, 2)
  other_monthly_income   Decimal?             @db.Decimal(12, 2)
  fixed_expenses         Decimal              @db.Decimal(12, 2)
  variable_expenses      Decimal              @db.Decimal(12, 2)
  existing_debt_total    Decimal?             @db.Decimal(12, 2)
  current_savings        Decimal?             @db.Decimal(12, 2)
  monthly_savings_target Decimal              @db.Decimal(12, 2)
  investment_experience  InvestmentExperience?
  risk_tolerance         RiskTolerance?
  already_investing      Boolean
  invested_amount        Decimal?             @db.Decimal(12, 2)
  emergency_fund_months  EmergencyFundMonths?
  onboarding_completed   Boolean              @default(false)
  payday                 Int?
  budget_split           Json?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  @@map("user_financial_profile")
}

model UserGoal {
  id            String                @id @default(cuid())
  user_id       String
  user          User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name          String                @db.VarChar(100)
  target_amount Decimal               @db.Decimal(12, 2)
  target_date   DateTime              @db.Date
  priority      GoalPriority
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt
  contributions UserGoalContribution[]

  @@index([user_id])
  @@map("user_goals")
}

model UserGoalContribution {
  id         String   @id @default(cuid())
  goal_id    String
  goal       UserGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @db.Date
  note       String?  @db.VarChar(140)
  created_at DateTime @default(now())

  @@index([goal_id])
  @@index([user_id])
  @@map("user_goal_contributions")
}

model UserBill {
  id         String            @id @default(cuid())
  user_id    String
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name       String            @db.VarChar(80)
  amount     Decimal           @db.Decimal(12, 2)
  due_date   DateTime          @db.Date
  auto_pay   Boolean           @default(false)
  // Monthly recurrence ("monthly") or null for a one-off bill. Paying
  // a monthly bill generates its next occurrence (same amount, due
  // date one month on). Only "monthly" exists today; the CHECK
  // constraint in the migration enforces it at the database level.
  recurrence String?
  // B37: the bill this occurrence was generated from (null for a bill
  // the user created directly). Deleting the parent deletes the
  // generated occurrence, so a removed payment/bill leaves no phantom
  // next bill behind.
  parent_bill_id String?
  parent         UserBill?  @relation("BillOccurrence", fields: [parent_bill_id], references: [id], onDelete: Cascade)
  children       UserBill[] @relation("BillOccurrence")
  created_at DateTime          @default(now())
  payments   UserBillPayment[]

  @@index([user_id, due_date])
  @@index([parent_bill_id])
  @@map("user_bills")
}

model UserBillPayment {
  id         String   @id @default(cuid())
  bill_id    String
  bill       UserBill @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  paid_date  DateTime @db.Date
  created_at DateTime @default(now())
  // B37: the expense transaction this payment generated (if any).
  // Deleting the payment deletes the expense via the FK on the
  // transaction side.
  expenseTransaction UserTransaction?

  @@index([bill_id])
  @@index([user_id])
  @@map("user_bill_payments")
}

model UserTransaction {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(80)
  category   String   @db.VarChar(40)
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @db.Date
  created_at DateTime @default(now())
  // B37: the bill payment that generated this expense (null for an
  // expense the user entered directly). One payment generates at most
  // one expense; deleting the payment deletes this row.
  bill_payment_id String?          @unique
  payment         UserBillPayment? @relation(fields: [bill_payment_id], references: [id], onDelete: Cascade)

  @@index([user_id, date])
  @@map("user_transactions")
}

model UserHolding {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  symbol     String   @db.VarChar(20)
  name       String?  @db.VarChar(120)
  sector     String?  @db.VarChar(80)
  quantity   Decimal  @db.Decimal(12, 4)
  buy_price  Decimal  @db.Decimal(12, 2)
  buy_date   DateTime @db.Date
  // Currency the buy price is entered in. Holdings are valued only
  // against a quote in the same currency — a USD holding is never
  // rendered or totalled as ₹.
  currency   String   @db.VarChar(8) @default("INR")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, symbol])
  @@map("user_holdings")
}

model WatchlistItem {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  symbol     String   @db.VarChar(20)
  name       String?  @db.VarChar(120)
  note       String?  @db.VarChar(500)
  alert_direction String? @db.VarChar(5)
  alert_price Decimal? @db.Decimal(14, 2)
  // When the configured alert last fired (null = never fired, or
  // re-armed after the price moved back across the threshold).
  // Evaluated on the market-overview load — there is no background
  // job system, so a fired alert notifies once per crossing.
  alert_fired_at DateTime?
  // The quote currency at the moment the alert last fired (B26) —
  // stored so the notification centre never has to guess a currency.
  // Cleared on re-arm; null means unknown.
  alert_currency String? @db.VarChar(3)
  created_at DateTime @default(now())

  @@unique([user_id, symbol])
  @@map("watchlist_items")
}

model MarketQuote {
  symbol         String   @id @db.VarChar(20)
  name           String?  @db.VarChar(120)
  price          Decimal  @db.Decimal(14, 4)
  previous_close Decimal? @db.Decimal(14, 4)
  currency       String   @db.VarChar(8)
  sector         String?  @db.VarChar(80)
  fetched_at     DateTime

  @@map("market_quotes")
}

model MarketHistory {
  id         String   @id @default(cuid())
  symbol     String   @db.VarChar(20)
  date       DateTime @db.Date
  open       Decimal  @db.Decimal(14, 4)
  high       Decimal  @db.Decimal(14, 4)
  low        Decimal  @db.Decimal(14, 4)
  close      Decimal  @db.Decimal(14, 4)
  volume     BigInt?
  fetched_at DateTime

  @@unique([symbol, date])
  @@map("market_history")
}

// One chunk of retrievable text for RAG (Phase 2). source_type is one of
// 'news' (public market news), 'profile' (public company text) or
// 'transaction' (the user's own transaction notes). user_id is NULL for
// public content and set for user-owned content; retrieval always scopes
// to (user_id IS NULL OR user_id = <session user>), so a user can only
// ever retrieve their own records plus public market content.
//
// The embedding column is Unsupported: Prisma cannot read or write
// pgvector values through the typed client, so all embedding access goes
// through $queryRaw / $executeRaw in the RAG repository. The dimension
// (768) must match the embedding model — baai/bge-base-en-v1.5 by default
// (see apps/backend/src/rag/rag.config.ts); changing the model to one
// with a different dimension needs a new migration.
model RagDocument {
  id           String   @id @default(cuid())
  source_type  String
  source_id    String
  user_id      String?
  user         User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  symbol       String?  @db.VarChar(20)
  title        String?
  content      String
  embedding    Unsupported("vector(768)")
  published_at DateTime?
  url          String?
  metadata     Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([source_type, source_id])
  @@index([user_id])
  @@index([symbol])
  @@index([source_type, published_at])
  @@map("rag_documents")
}

// B44: idempotency keys for POST creates (bill, payment, transaction,
// goal contribution). A client sends a unique X-Idempotency-Key header
// per request; the UNIQUE(user_id, key) constraint rejects a replay
// within 24 hours with 409 DUPLICATE_REQUEST. Keys older than 24 hours
// are expired and may be reused. Rows are never read for any other
// purpose; there is intentionally no response-caching of the original
// result — the client retries with a fresh key after a failure.
model IdempotencyKey {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  key        String
  endpoint   String
  created_at DateTime @default(now())

  @@unique([user_id, key])
  @@index([user_id, created_at])
  @@map("idempotency_keys")
}

// One guardrail check on one LLM claim (Phase 3). Every check the
// guardrail runs — numeric comparison, source existence, text-number
// match, citation match — is logged here, pass or fail, with the
// claimed and verified values, so Phase 5 can compute the guardrail
// pass rate (the factual-grounding metric) from this table. request_id
// correlates the checks of one answer; attempt distinguishes the first
// verification from the one retry.
model GuardrailCheck {
  id          String   @id @default(cuid())
  request_id  String
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  feature     String
  attempt     Int
  claim_text  String
  source_tool String
  check_type  String
  expected    String?
  actual      String?
  verdict     String
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([feature])
  @@index([request_id])
  @@map("guardrail_checks")
}
