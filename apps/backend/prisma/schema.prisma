generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  password      String?
  emailVerified Boolean @default(false)

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  image            String?
  sessions         Session[]
  accounts         Account[]
  financialProfile UserFinancialProfile?
  goals            UserGoal[]
  bills            UserBill[]
  billPayments     UserBillPayment[]
  transactions     UserTransaction[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum EmploymentType {
  salaried
  self_employed @map("self-employed")
  student
  other
}

enum InvestmentExperience {
  none
  beginner
  intermediate
  advanced
}

enum RiskTolerance {
  low
  medium
  high
}

enum GoalPriority {
  low
  medium
  high
}

enum EmergencyFundMonths {
  zero         @map("0")
  one_to_three @map("1-3")
  three_to_six @map("3-6")
  six_plus     @map("6+")
}

model UserFinancialProfile {
  user_id                String               @id
  user                   User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  employment_type        EmploymentType
  monthly_income         Decimal              @db.Decimal(12, 2)
  other_monthly_income   Decimal?             @db.Decimal(12, 2)
  fixed_expenses         Decimal              @db.Decimal(12, 2)
  variable_expenses      Decimal              @db.Decimal(12, 2)
  existing_debt_total    Decimal?             @db.Decimal(12, 2)
  current_savings        Decimal              @db.Decimal(12, 2)
  monthly_savings_target Decimal              @db.Decimal(12, 2)
  investment_experience  InvestmentExperience
  risk_tolerance         RiskTolerance
  already_investing      Boolean
  invested_amount        Decimal?             @db.Decimal(12, 2)
  emergency_fund_months  EmergencyFundMonths
  onboarding_completed   Boolean              @default(false)
  payday                 Int?
  budget_split           Json?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  @@map("user_financial_profile")
}

model UserGoal {
  id            String       @id @default(cuid())
  user_id       String
  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name          String       @db.VarChar(100)
  target_amount Decimal      @db.Decimal(12, 2)
  target_date   DateTime     @db.Date
  priority      GoalPriority
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@index([user_id])
  @@map("user_goals")
}

model UserBill {
  id         String            @id @default(cuid())
  user_id    String
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name       String            @db.VarChar(80)
  amount     Decimal           @db.Decimal(12, 2)
  due_date   DateTime          @db.Date
  auto_pay   Boolean           @default(false)
  created_at DateTime          @default(now())
  payments   UserBillPayment[]

  @@index([user_id, due_date])
  @@map("user_bills")
}

model UserBillPayment {
  id         String   @id @default(cuid())
  bill_id    String
  bill       UserBill @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  paid_date  DateTime @db.Date
  created_at DateTime @default(now())

  @@index([bill_id])
  @@index([user_id])
  @@map("user_bill_payments")
}

model UserTransaction {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(80)
  category   String   @db.VarChar(40)
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime @db.Date
  created_at DateTime @default(now())

  @@index([user_id, date])
  @@map("user_transactions")
}
