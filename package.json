{
  "name": "finverse-main",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,css,json}\" \"packages/**/*.{js,json}\" \"scripts/*.mjs\" package.json turbo.json README.md docs/production-review.md",
    "check-types": "turbo run check-types",
    "test": "npm run test --workspace backend -- --runInBand && npm run test:e2e --workspace backend -- --runInBand && npm run test --workspace web",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,css,json}\" \"packages/**/*.{js,json}\" \"scripts/*.mjs\" package.json turbo.json README.md docs/production-review.md",
    "bundle:report": "node scripts/measure-bundle.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.20.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "prisma": "^6.16.3"
  }
}
